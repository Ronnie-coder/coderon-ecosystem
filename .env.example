# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ---
ADMIN_PASSWORD=
# Optional: separate secret for signing the session cookie (defaults to ADMIN_PASSWORD)
AUTH_SECRET=

# --- Outreach email (Resend) ---
RESEND_OUTREACH_API_KEY=        # account/domain that sends pitches from ronnie@coderon.co.za
RESEND_WEBHOOK_SECRET=          # whsec_... from the Resend webhook page (verifies open/click events)
RESEND_API_KEY=                 # system mail: contact form + daily digest
# Free-plan guard rails (defaults shown)
# OUTREACH_DAILY_EMAIL_CAP=80
# OUTREACH_MONTHLY_EMAIL_CAP=2800
# OUTREACH_RAMP_START=2026-10-15   # daily pitch target: 10 -> 15 -> 20 -> 25 per week
# OUTREACH_DAILY_PITCH_TARGET=     # set to override the ramp
# BUSINESS_ADDRESS="Coderon (Pty) Ltd · Reg 2025/482790/07 · Cape Town, South Africa"
# DIGEST_TO=ronnie@coderon.co.za

# --- Lead sourcing & audit ---
SERPER_API_KEY=
PAGESPEED_API_KEY=              # free Google API key (PageSpeed Insights API) - powers speed claims
HUNTER_API_KEY=                 # optional, free plan = 25 searches/month

# --- Cron (cron-job.org) ---
# When set, hunter/enrich/followup require ?key=<CRON_SECRET> on the URL
CRON_SECRET=

# --- Notion sync (optional) ---
NOTION_TOKEN=                   # internal integration secret
NOTION_OUTREACH_DB=30bdf14af359809c9d31d83f3a7e226f
